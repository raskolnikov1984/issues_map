# Repositorio de persistencia: memory | postgres
REPOSITORY=memory

# Conexion a Postgres (usada cuando REPOSITORY=postgres;
# coincide con compose.test.yaml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db

# Ejecuta los tests de integracion contra Postgres (requiere el contenedor arriba)
RUN_DB_TESTS=false
